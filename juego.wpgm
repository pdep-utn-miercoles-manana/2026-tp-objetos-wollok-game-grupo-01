
import wollok.game.*
import november.*
import jugador.*
import pantallaInicio.*
import sonidos.*

program programaPrincipal {
    game.title("November is Coming - UTN FRBA")
    game.width(20)
    game.height(12)
    game.cellSize(50)

    
game.boardGround("fondoPiso.png")

const portada = object {
    method position() = game.at(0, 0)
    method image() = "pantallaInicioPropia.png"
}

game.addVisual(portada)

const ayudaInicio = new TextoInicio(
    position = game.at(5, 1),
    contenido = "HACÉ CLIC EN JUGAR",
    colorActual = "FFD166FF")

game.addVisual(ayudaInicio)

game.schedule(300, { sonidos.precargar() })

var partidaIniciada = false

game.onClickDo({ posicion =>
    if (not partidaIniciada) {
        partidaIniciada = true
        game.removeVisual(portada)
        game.removeVisual(ayudaInicio)
        juego.empezar()
    }
})

game.start()

}
