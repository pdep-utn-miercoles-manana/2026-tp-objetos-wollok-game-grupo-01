import wollok.game.*
import november.*
import jugador.*


program programaPrincipal {
    game.title("November is Coming - UTN FRBA")
    game.width(20)
    game.height(12)
    game.cellSize(50) 
    
    // Primero mostramos la pantalla de inicio; el juego arranca al presionar Enter/Espacio.
    juego.mostrarPantallaInicio()

    // Arranca el motor
    game.start()
}