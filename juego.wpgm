import wollok.game.*
import november.*
import jugador.*

program programaPrincipal {
    game.title("November is Coming - UTN FRBA")
    game.width(15)
    game.height(10)
    game.cellSize(50)
    
    // Le pedimos al objeto controlador que inicie el juego
    juego.iniciar()

    // Arranca el motor
    game.start()
}