// Tests del BFS, con el piso de prueba.
import wollok.game.*
import buscador.*
import soporteDePruebas.*

describe "Buscador de caminos" {

  method pisoLibre() = new PisoDePrueba(ancho = 5, alto = 5)

  test "si ya está en el destino no se mueve" {
    const piso = self.pisoLibre()

    const paso = buscadorDeCaminos.primerPasoHacia(game.at(2, 2), game.at(2, 2), piso)

    assert.equals(game.at(2, 2), paso)
  }

  test "va derecho cuando no hay nada en el medio" {
    const piso = self.pisoLibre()

    const paso = buscadorDeCaminos.primerPasoHacia(game.at(0, 0), game.at(3, 0), piso)

    assert.equals(game.at(1, 0), paso)
  }

  test "rodea una pared en vez de chocarse" {
    const piso = self.pisoLibre()
    piso.obstaculos().add(game.at(1, 0))

    const paso = buscadorDeCaminos.primerPasoHacia(game.at(0, 0), game.at(2, 0), piso)

    assert.equals(game.at(0, 1), paso)
  }

  test "busca el hueco de una pared larga" {
    const piso = self.pisoLibre()
    piso.obstaculos().add(game.at(1, 0))
    piso.obstaculos().add(game.at(1, 1))

    const paso = buscadorDeCaminos.primerPasoHacia(game.at(0, 0), game.at(2, 0), piso)

    assert.equals(game.at(0, 1), paso)
  }

  test "si no hay camino se queda en el origen" {
    const piso = self.pisoLibre()
    (0..4).forEach({ y => piso.obstaculos().add(game.at(1, y)) })

    const paso = buscadorDeCaminos.primerPasoHacia(game.at(0, 0), game.at(4, 0), piso)

    assert.equals(game.at(0, 0), paso)
  }

  test "nunca propone una celda de afuera del piso" {
    const piso = self.pisoLibre()

    const paso = buscadorDeCaminos.primerPasoHacia(game.at(0, 0), game.at(4, 4), piso)

    assert.that(paso.x() >= 0 and paso.x() < 5 and paso.y() >= 0 and paso.y() < 5)
  }
}
